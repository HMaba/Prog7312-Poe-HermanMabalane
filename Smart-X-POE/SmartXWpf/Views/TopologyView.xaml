<Page x:Class="SmartXWpf.Views.TopologyView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Network Topology and Mesh Routing" FontSize="25" FontWeight="Bold" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,12,10">
            <Canvas x:Name="MeshCanvas" Background="#FAFAFA" ClipToBounds="True" SizeChanged="MeshCanvas_SizeChanged"/>
        </Border>

        <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="1">
            <TextBlock Text="Sensor (MAC / ID)" FontWeight="Bold"/>
            <ComboBox ItemsSource="{Binding SelectableNodes}" DisplayMemberPath="Display" SelectedValuePath="Id" SelectedValue="{Binding SelectedMac, Mode=TwoWay}" Height="30" Margin="0,4,0,10"/>

            <TextBlock Text="{Binding RouteText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Fail node" Click="Fail_Click" Height="32" Margin="0,0,4,0"/>
                <Button Grid.Column="1" Content="Restore node" Click="Restore_Click" Height="32" Margin="4,0,0,0"/>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="DarkSlateGray" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <TextBlock Text="Legend" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <Ellipse Width="14" Height="14" Fill="SeaGreen"/>
                <TextBlock Text="Node up" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Ellipse Width="14" Height="14" Fill="Crimson"/>
                <TextBlock Text="Node down" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Rectangle Width="24" Height="4" Fill="LightGray"/>
                <TextBlock Text="Mesh link" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Rectangle Width="24" Height="5" Fill="ForestGreen"/>
                <TextBlock Text="Minimum spanning tree link" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Rectangle Width="24" Height="6" Fill="DarkOrange"/>
                <TextBlock Text="Selected route" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Sensor History" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>

            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="From" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" ToolTip="yyyy-MM-dd HH:mm:ss, blank for no limit"/>
                <TextBlock Grid.Column="2" Text="To" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <TextBox Grid.Column="3" Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" ToolTip="yyyy-MM-dd HH:mm:ss, blank for no limit"/>
                <Button Grid.Column="4" Content="Search" Click="HistorySearch_Click" Height="28" Margin="12,0,0,0"/>
            </Grid>

            <DataGrid Grid.Row="2" ItemsSource="{Binding HistoryRows}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="1.5*"/>
                    <DataGridTextColumn Header="Moisture %" Binding="{Binding SoilMoisture, StringFormat=F1}" Width="*"/>
                    <DataGridTextColumn Header="Temp C" Binding="{Binding Temperature, StringFormat=F1}" Width="*"/>
                    <DataGridTextColumn Header="Humidity %" Binding="{Binding Humidity, StringFormat=F1}" Width="*"/>
                    <DataGridTextColumn Header="Flow" Binding="{Binding WaterFlow, StringFormat=F1}" Width="*"/>
                    <DataGridTextColumn Header="Battery %" Binding="{Binding Battery, StringFormat=F1}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HistoryMessage}" TextWrapping="Wrap" VerticalAlignment="Bottom" Foreground="DarkSlateGray"/>
    </Grid>
</Page>
