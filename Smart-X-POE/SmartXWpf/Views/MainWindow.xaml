<Window x:Class="SmartXWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartX Farm Monitoring" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="15">
            <TextBlock Text="SMARTX FARM MONITOR" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="ApiStatus" DockPanel.Dock="Right" Text="API CHECKING..." VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Button x:Name="SensorModuleButton" Click="SensorModule_Click" Margin="0,0,0,8" Height="64">
                    <TextBlock Text="Sensor Data Ingestion and Telemetry" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
                <Button x:Name="CommandModuleButton" Click="CommandModule_Click" Margin="0,0,0,8" Height="64">
                    <TextBlock Text="Real-Time Command Stream and History" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
                <Button x:Name="TopologyModuleButton" Click="TopologyModule_Click" Margin="0,0,0,8" Height="64">
                    <TextBlock Text="Network Topology and Mesh Routing" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>
            </StackPanel>

            <Grid Grid.Column="1" Margin="20,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel x:Name="SensorSubMenu" Margin="0,0,0,10">
                    <Button Content="Dashboard" Click="Dashboard_Click" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="Sensors" Click="Sensors_Click" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="Telemetry" Click="Telemetry_Click" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="Alerts" Click="Alerts_Click" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="Facility Power" Click="Power_Click" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="Upload File" Click="Upload_Click" Height="32" Padding="14,0"/>
                </WrapPanel>

                <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
