<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="SmartXWpf.Views.DashboardView"
      >
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="Live Dashboard" FontSize="26" FontWeight="Bold" Margin="0,0,0,15"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Sensors"/>
                        <TextBlock x:Name="SensorCount" FontSize="25" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Alerts"/>
                        <TextBlock x:Name="AlertCount" FontSize="25" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Facility Power"/>
                        <TextBlock x:Name="PowerStatus" FontSize="25" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="Battery"/>
                        <TextBlock x:Name="BatteryStatus" FontSize="25" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Live Telemetry" FontSize="20" FontWeight="Bold"/>
            <DataGrid x:Name="TelemetryGrid" AutoGenerateColumns="False" Height="220" Margin="0,8,0,15">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sensor" Binding="{Binding SensorId}"/>
                    <DataGridTextColumn Header="Zone" Binding="{Binding Zone}"/>
                    <DataGridTextColumn Header="Moisture %" Binding="{Binding SoilMoisture, StringFormat=F1}"/>
                    <DataGridTextColumn Header="Temp C" Binding="{Binding Temperature, StringFormat=F1}"/>
                    <DataGridTextColumn Header="Humidity %" Binding="{Binding Humidity, StringFormat=F1}"/>
                    <DataGridTextColumn Header="Water L/min" Binding="{Binding WaterFlow, StringFormat=F1}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Live Alerts" FontSize="20" FontWeight="Bold"/>
            <ListBox x:Name="AlertList" Height="150" Margin="0,8,0,15"/>

            <TextBlock Text="Facility Power" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="PowerDetails" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>